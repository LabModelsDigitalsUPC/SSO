        <rdfs:label xml:lang="en">as Abaqus INP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#as_ifc-sa -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#as_ifc-sa">
