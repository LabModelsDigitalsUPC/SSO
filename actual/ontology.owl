        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The prescribed rotation value about Y, when the boundary condition imposes a rotation rather than a simple restraint.</rdfs:comment>
        <rdfs:label xml:lang="en">prescribed rotation (ry)</rdfs:label>
    </owl:DatatypeProperty>
    


