        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unit of temperature used by the model (e.g. &apos;CELSIUS&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">temperature unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#thickness -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#thickness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#ShellSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The shell section&apos;s thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">thickness</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#time -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#time">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Units"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unit of time used by the model (e.g. &apos;SECOND&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">time unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#translation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#translation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Instance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The translation applied to an Instance when placing its Object in the Assembly.</rdfs:comment>
        <rdfs:label xml:lang="en">translation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#v -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#v">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
