        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The width of the first flange of an I-shaped profile.</rdfs:comment>
        <rdfs:label xml:lang="en">flange width b1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#b2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#b2">
