        <rdfs:domain rdf:resource="https://w3id.org/sso#BoundaryCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the boundary condition constrains rotation about Z.</rdfs:comment>
