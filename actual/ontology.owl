        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The magnitude of a Point Load or Surface Load.</rdfs:comment>
        <rdfs:label xml:lang="en">load magnitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#v1 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#v1">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#DistributedLoad"/>
