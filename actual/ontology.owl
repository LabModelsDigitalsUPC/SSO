    <!-- https://w3id.org/sso#rotation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#rotation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
