     -->


    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- https://w3id.org/sso#ArbitraryProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#ArbitraryProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">An arbitrary polygonal cross-section, optionally with holes; its point geometry isn&apos;t structurally modeled in this ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Arbitrary Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Assembly -->


    <owl:Class rdf:about="https://w3id.org/sso#Assembly">
        <rdfs:comment xml:lang="en">The collection of Instances that, together, position the model&apos;s Objects in the global coordinate system — the assembled structural model on which Sets, Loads, and Boundary Conditions are defined.</rdfs:comment>
        <rdfs:label xml:lang="en">Assembly</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#BeamElement -->


    <owl:Class rdf:about="https://w3id.org/sso#BeamElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:comment xml:lang="en">A finite element idealizing a slender linear structural member, such as a beam or column, via its cross-section.</rdfs:comment>
        <rdfs:label xml:lang="en">Beam Element</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#BeamSection -->


    <owl:Class rdf:about="https://w3id.org/sso#BeamSection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Section"/>
        <rdfs:comment xml:lang="en">A section assigning a named beam profile and orientation to beam elements, carrying exactly one typed Cross-Section Profile for its geometry.</rdfs:comment>
        <rdfs:label xml:lang="en">Beam Section</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#BoundaryCondition -->


    <owl:Class rdf:about="https://w3id.org/sso#BoundaryCondition">
        <rdfs:comment xml:lang="en">A restraint or prescribed displacement applied to a node set, specified per degree of freedom (ux, uy, uz, rx, ry, rz).</rdfs:comment>
        <rdfs:label xml:lang="en">Boundary Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#BoxProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#BoxProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A rectangular hollow cross-section, defined by its outer width/height and wall thicknesses.</rdfs:comment>
        <rdfs:label xml:lang="en">Box Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Calibration -->


    <owl:Class rdf:about="https://w3id.org/sso#Calibration">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">A provenance-bearing event (a prov:Activity) that produces a calibrated snapshot of a model parameter from a baseline, using measured test data.</rdfs:comment>
        <rdfs:label xml:lang="en">Calibration</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#CircProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#CircProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A solid circular cross-section, defined by its radius.</rdfs:comment>
        <rdfs:label xml:lang="en">Circular Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#CoordinateSystem -->


    <owl:Class rdf:about="https://w3id.org/sso#CoordinateSystem">
        <rdfs:comment xml:lang="en">A local coordinate system defined by its X, Y, and Z axis vectors.</rdfs:comment>
        <rdfs:label xml:lang="en">Coordinate System</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#CrossSectionProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#CrossSectionProfile">
        <rdfs:comment xml:lang="en">The parametric geometric shape of a beam&apos;s cross-section — an abstract type with concrete parametric profiles such as Rectangular, Box, and I-Profile — assigned to a Beam Section.</rdfs:comment>
        <rdfs:label xml:lang="en">Cross-Section Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#DistributedLoad -->


    <owl:Class rdf:about="https://w3id.org/sso#DistributedLoad">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Load"/>
        <rdfs:comment xml:lang="en">A load distributed linearly along an element edge/line, defined by its direction and end values.</rdfs:comment>
        <rdfs:label xml:lang="en">Distributed Load</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#ElasticBehaviour -->


    <owl:Class rdf:about="https://w3id.org/sso#ElasticBehaviour">
        <rdfs:comment xml:lang="en">The linear-elastic constitutive response of a material, defined by its behaviour type (isotropic, anisotropic, or orthotropic) and elastic parameters (Young&apos;s modulus, Poisson&apos;s ratio).</rdfs:comment>
        <rdfs:label xml:lang="en">Elastic Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Element -->


    <owl:Class rdf:about="https://w3id.org/sso#Element">
        <rdfs:comment xml:lang="en">A discretized finite element in a structural mesh, the basic unit solved by the analysis (e.g. a solid, shell, or beam element).</rdfs:comment>
        <rdfs:label xml:lang="en">Finite Element</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Elset -->


    <owl:Class rdf:about="https://w3id.org/sso#Elset">
        <rdfs:comment xml:lang="en">A named group of elements, defined on an assembled Instance, used to scope distributed and surface loads to a specific part of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">Element Set</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#GeneralProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#GeneralProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A cross-section defined directly by its section properties (area, moments of inertia, torsional constant) rather than by shape.</rdfs:comment>
        <rdfs:label xml:lang="en">General Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#HexProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#HexProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A hexagonal hollow cross-section, defined by its circumscribed radius and wall thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">Hexagonal Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#IProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#IProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">An I-shaped (wide-flange) cross-section, defined by its overall depth, flange widths and thicknesses, and web thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">I-Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Instance -->


    <owl:Class rdf:about="https://w3id.org/sso#Instance">
        <rdfs:comment xml:lang="en">A placement of a structural Object within the Assembly: references the Object and applies the spatial transformation between the Object&apos;s local coordinate system and the model&apos;s global coordinate system. Multiple Instances may reference the same Object to replicate an identical mesh without duplicating its data, and carry their own Node/Element Sets for scoping loads and boundary conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Instance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#LProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#LProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">An L-shaped (angle) cross-section, defined by its two leg widths and thicknesses.</rdfs:comment>
        <rdfs:label xml:lang="en">L-Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Load -->


    <owl:Class rdf:about="https://w3id.org/sso#Load">
        <rdfs:comment xml:lang="en">An action applied to the structure within a Load Case — a point, distributed, or surface load.</rdfs:comment>
        <rdfs:label xml:lang="en">Load</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#LoadCase -->


    <owl:Class rdf:about="https://w3id.org/sso#LoadCase">
        <rdfs:comment xml:lang="en">A named grouping of loads applied together in one analysis case, optionally including a self-weight contribution.</rdfs:comment>
        <rdfs:label xml:lang="en">Load Case</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Material -->


    <owl:Class rdf:about="https://w3id.org/sso#Material">
        <rdfs:comment xml:lang="en">A structural material, assigned to elements via a Section, whose constitutive behaviour is decomposed into a required Elastic Behaviour and an optional Plastic Behaviour, alongside its density.</rdfs:comment>
        <rdfs:label xml:lang="en">Material</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Mesh -->


    <owl:Class rdf:about="https://w3id.org/sso#Mesh">
        <rdfs:comment xml:lang="en">The finite element discretization of an Object: its nodes and elements.</rdfs:comment>
        <rdfs:label xml:lang="en">Mesh</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Node -->


    <owl:Class rdf:about="https://w3id.org/sso#Node">
        <rdfs:comment xml:lang="en">A meshed point in space, identified by its coordinates, that finite elements connect to.</rdfs:comment>
        <rdfs:label xml:lang="en">Node</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Nset -->


    <owl:Class rdf:about="https://w3id.org/sso#Nset">
        <rdfs:comment xml:lang="en">A named group of nodes, defined on an assembled Instance, used to scope loads and boundary conditions to a specific part of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">Node Set</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Object -->


    <owl:Class rdf:about="https://w3id.org/sso#Object">
        <rdfs:comment xml:lang="en">A structural component (e.g. a beam, shell, or solid assembly) defined in its own local coordinate system: its Mesh of Nodes and Elements, referencing Sections and Materials. An Object is defined once and positioned in the model via one or more Instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Structural Object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#PipeProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#PipeProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A circular hollow cross-section, defined by its outer radius and wall thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">Pipe Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#PlasticBehaviour -->


    <owl:Class rdf:about="https://w3id.org/sso#PlasticBehaviour">
        <rdfs:comment xml:lang="en">The plastic (post-yield) constitutive response of a material, defined by its yield stress and plastic strain.</rdfs:comment>
        <rdfs:label xml:lang="en">Plastic Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#PointLoad -->


    <owl:Class rdf:about="https://w3id.org/sso#PointLoad">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Load"/>
        <rdfs:comment xml:lang="en">A concentrated load applied to a single degree of freedom of a node set.</rdfs:comment>
        <rdfs:label xml:lang="en">Point Load</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#RectProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#RectProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A solid rectangular cross-section, defined by its width and height.</rdfs:comment>
        <rdfs:label xml:lang="en">Rectangular Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Section -->


    <owl:Class rdf:about="https://w3id.org/sso#Section">
        <rdfs:comment xml:lang="en">A structural section that assigns geometric and material properties to the elements referencing it; an abstract type with three concrete kinds — Beam, Shell, and Solid Section.</rdfs:comment>
        <rdfs:label xml:lang="en">Section</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#ShellElement -->


    <owl:Class rdf:about="https://w3id.org/sso#ShellElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:comment xml:lang="en">A finite element idealizing a thin plate/shell structural member, such as a slab or wall.</rdfs:comment>
        <rdfs:label xml:lang="en">Shell Element</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#ShellSection -->


    <owl:Class rdf:about="https://w3id.org/sso#ShellSection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Section"/>
        <rdfs:comment xml:lang="en">A section assigning a single thickness to shell elements, used for plate/shell structural members like slabs and walls.</rdfs:comment>
        <rdfs:label xml:lang="en">Shell Section</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#SolidElement -->


    <owl:Class rdf:about="https://w3id.org/sso#SolidElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:comment xml:lang="en">A finite element with a full 3D solid formulation (e.g. a continuum brick/tetrahedron element).</rdfs:comment>
        <rdfs:label xml:lang="en">Solid Element</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#SolidSection -->


    <owl:Class rdf:about="https://w3id.org/sso#SolidSection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Section"/>
        <rdfs:comment xml:lang="en">A section for solid elements, whose geometry comes entirely from the mesh rather than parametric properties.</rdfs:comment>
        <rdfs:label xml:lang="en">Solid Section</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#StructuralAnalysisModel -->


    <owl:Class rdf:about="https://w3id.org/sso#StructuralAnalysisModel">
        <rdfs:comment xml:lang="en">A complete structural analysis (simulation) model: it composes a unit system, one or more structural Objects, an Assembly of their Instances, and collections of Materials, Sections, Load Cases, Loads, and Boundary Conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Structural Analysis Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#SurfaceLoad -->


    <owl:Class rdf:about="https://w3id.org/sso#SurfaceLoad">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#Load"/>
        <rdfs:comment xml:lang="en">A pressure load applied over an element face, defined by its magnitude and direction.</rdfs:comment>
        <rdfs:label xml:lang="en">Surface Load</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#TrapezoidProfile -->


    <owl:Class rdf:about="https://w3id.org/sso#TrapezoidProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">A trapezoidal cross-section, defined by its bottom and top widths, height, and top-edge offset.</rdfs:comment>
        <rdfs:label xml:lang="en">Trapezoid Profile</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Units -->


    <owl:Class rdf:about="https://w3id.org/sso#Units">
        <rdfs:comment xml:lang="en">The unit system (force, length, temperature, time, mass) in which a Structural Analysis Model&apos;s values are expressed.</rdfs:comment>
        <rdfs:label xml:lang="en">Units</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/sso#Vector3D -->


    <owl:Class rdf:about="https://w3id.org/sso#Vector3D">
        <rdfs:comment xml:lang="en">A three-component (X, Y, Z) vector, used for coordinate axes, beam orientation, and self-weight direction.</rdfs:comment>
        <rdfs:label xml:lang="en">3D Vector</rdfs:label>
    </owl:Class>
</rdf:RDF>



