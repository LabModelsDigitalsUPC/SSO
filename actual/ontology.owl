        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of nodes in a Mesh, or referenced by an Element.</rdfs:comment>
        <rdfs:label xml:lang="en">node count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#plastic_strain -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#plastic_strain">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#PlasticBehaviour"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The plastic (permanent) strain corresponding to the yield stress in the material&apos;s plastic behaviour.</rdfs:comment>
        <rdfs:label xml:lang="en">plastic strain</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#poisson_ratio -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#poisson_ratio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#ElasticBehaviour"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The material&apos;s Poisson&apos;s ratio, the ratio of transverse to axial strain in the elastic range.</rdfs:comment>
        <rdfs:label xml:lang="en">Poisson&apos;s ratio</rdfs:label>
    </owl:DatatypeProperty>
    


