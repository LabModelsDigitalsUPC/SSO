        <rdfs:comment xml:lang="en">The prescribed rotation value about Z, when the boundary condition imposes a rotation rather than a simple restraint.</rdfs:comment>
        <rdfs:label xml:lang="en">prescribed rotation (rz)</rdfs:label>
    </owl:DatatypeProperty>
    


