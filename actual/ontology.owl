        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The prescribed rotation value about X, when the boundary condition imposes a rotation rather than a simple restraint.</rdfs:comment>
        <rdfs:label xml:lang="en">prescribed rotation (rx)</rdfs:label>
    </owl:DatatypeProperty>
    


