        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A link to this model serialized as an IFC structural-analysis-domain file.</rdfs:comment>
        <rdfs:label xml:lang="en">as IFC Structural Analysis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#b -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
