<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/sso#"
     xml:base="https://w3id.org/sso"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/sso#">
        <ns:license>http://creativecommons.org/licenses/by/3.0/</ns:license>
        <terms:creator>Carlos Ramonell Cazador (carlos.ramonell@upc.edu)</terms:creator>
        <terms:creator>Héctor Posada Cárcamo (hector.posada@upc.edu)</terms:creator>
        <terms:creator>Rolando Chacón Flores (rolando.chacon@upc.edu)</terms:creator>
        <terms:date>2026/04/04</terms:date>
        <terms:description xml:lang="en">SSO describes structural analysis models, their materials and constitutive behaviours, and the calibration events that update those behaviours against measured data.</terms:description>
        <terms:description>Ontology containing the description of structural simulation models (OSAM)</terms:description>
        <terms:format>ttl</terms:format>
        <terms:identifier>SSO</terms:identifier>
        <terms:language>en</terms:language>
        <terms:publisher>Universitat Politècnica de Catalunya</terms:publisher>
        <terms:title>SSO</terms:title>
        <vann:preferredNamespacePrefix>sso</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/sso#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">An ontology for representing structural analysis (simulation) models and linking their finite elements to the built elements they idealize, within the O-SAM ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">SSO — Structural Simulation Ontology</rdfs:label>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://creativecommons.org/ns#license -->


    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/date"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/format -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/format"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/dc/terms/language -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/language"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#used -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used"/>
    


    <!-- http://www.w3.org/ns/prov#wasGeneratedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    


    <!-- https://w3id.org/sso#applied_to -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#applied_to">
        <rdfs:range rdf:resource="https://w3id.org/sso#Instance"/>
        <rdfs:comment xml:lang="en">Links a Load or Boundary Condition to the Instance(s) it is scoped to. Domain is intentionally open.</rdfs:comment>
        <rdfs:label xml:lang="en">applied to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#calibrated_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#calibrated_by">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Calibration"/>
        <rdfs:comment xml:lang="en">Links a calibrated entity (e.g. a Material&apos;s Elastic Behaviour, a Boundary Condition) to the Calibration event that produced this snapshot of it. Domain is intentionally open.</rdfs:comment>
        <rdfs:label xml:lang="en">calibrated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#element_material -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#element_material">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Material"/>
        <rdfs:comment xml:lang="en">Links an Element to the Material assigned to it.</rdfs:comment>
        <rdfs:label xml:lang="en">element material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#element_section -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#element_section">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Section"/>
        <rdfs:comment xml:lang="en">Links an Element to the Section assigned to it.</rdfs:comment>
        <rdfs:label xml:lang="en">element section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#elset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#elset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Load"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Elset"/>
        <rdfs:comment xml:lang="en">Links a Distributed Load or Surface Load to the Element Set it acts on.</rdfs:comment>
        <rdfs:label xml:lang="en">element set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_assembly -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_assembly">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Assembly"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to its Assembly.</rdfs:comment>
        <rdfs:label xml:lang="en">has assembly</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_boundary_condition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_boundary_condition">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#BoundaryCondition"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to one of its Boundary Conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">has boundary condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_calibration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_calibration">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Calibration"/>
        <rdfs:comment xml:lang="en">Links an entity to the Calibration event(s) it has undergone; an entity may accumulate several calibrations over time. Domain is intentionally open, and it is the inverse of prov:used.</rdfs:comment>
        <rdfs:label xml:lang="en">has calibration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_coordinate_system -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_coordinate_system">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Object"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#CoordinateSystem"/>
        <rdfs:comment xml:lang="en">Links an Object to its local Coordinate System.</rdfs:comment>
        <rdfs:label xml:lang="en">has coordinate system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_cross_section -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_cross_section">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#BeamSection"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:comment xml:lang="en">Links a Beam Section to its Cross-Section Profile; always expected to be present.</rdfs:comment>
        <rdfs:label xml:lang="en">has cross-section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_elastic_behaviour -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_elastic_behaviour">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Material"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#ElasticBehaviour"/>
        <rdfs:comment xml:lang="en">Links a Material to its Elastic Behaviour.</rdfs:comment>
        <rdfs:label xml:lang="en">has elastic behaviour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_element -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_element">
        <rdfs:range rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:comment xml:lang="en">Links a Mesh or Element Set to an Element it contains. Domain is intentionally open.</rdfs:comment>
        <rdfs:label xml:lang="en">has element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_elset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_elset">
        <rdfs:domain rdf:resource="https://w3id.org/sso#Instance"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Elset"/>
        <rdfs:comment xml:lang="en">Links an Instance to one of its Element Sets.</rdfs:comment>
        <rdfs:label xml:lang="en">has element set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_instance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_instance">
        <rdfs:domain rdf:resource="https://w3id.org/sso#Assembly"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Instance"/>
        <rdfs:comment xml:lang="en">Links an Assembly to one of its Instances.</rdfs:comment>
        <rdfs:label xml:lang="en">has instance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_load -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_load">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Load"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to one of its Loads.</rdfs:comment>
        <rdfs:label xml:lang="en">has load</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_loadCase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_loadCase">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#LoadCase"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to one of its Load Cases.</rdfs:comment>
        <rdfs:label xml:lang="en">has load case</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_material -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_material">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Material"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to one of its Materials.</rdfs:comment>
        <rdfs:label xml:lang="en">has material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_mesh -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_mesh">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Object"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Mesh"/>
        <rdfs:comment xml:lang="en">Links an Object to its Mesh.</rdfs:comment>
        <rdfs:label xml:lang="en">has mesh</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_node -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_node">
        <rdfs:range rdf:resource="https://w3id.org/sso#Node"/>
        <rdfs:comment xml:lang="en">Links a Mesh, Node Set, or Element to a Node it contains or connects to. Domain is intentionally open; node ordering is not preserved.</rdfs:comment>
        <rdfs:label xml:lang="en">has node</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_nset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_nset">
        <rdfs:domain rdf:resource="https://w3id.org/sso#Instance"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Nset"/>
        <rdfs:comment xml:lang="en">Links an Instance to one of its Node Sets.</rdfs:comment>
        <rdfs:label xml:lang="en">has node set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_object -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_object">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Object"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to one of its constituent Objects.</rdfs:comment>
        <rdfs:label xml:lang="en">has object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_plastic_behaviour -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_plastic_behaviour">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Material"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#PlasticBehaviour"/>
        <rdfs:comment xml:lang="en">Links a Material to its Plastic Behaviour, when the material has one.</rdfs:comment>
        <rdfs:label xml:lang="en">has plastic behaviour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_section -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_section">
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Section"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to one of its Sections.</rdfs:comment>
        <rdfs:label xml:lang="en">has section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#has_units -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#has_units">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Units"/>
        <rdfs:comment xml:lang="en">Links a Structural Analysis Model to the Units it is expressed in.</rdfs:comment>
        <rdfs:label xml:lang="en">has units</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#idealized_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#idealized_by">
        <rdfs:range rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:comment xml:lang="en">Links an external built element (e.g. beo:Slab, bot:Element) to the SSO finite elements that idealize it in a structural analysis model (e.g. a set of Shell Elements). Domain is intentionally open.</rdfs:comment>
        <rdfs:label xml:lang="en">idealized by</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/beo#BuiltElement"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/bot#Element"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#in_loadCase -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#in_loadCase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Load"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#LoadCase"/>
        <rdfs:comment xml:lang="en">Links a Load to the Load Case it belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">in load case</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#nset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#nset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Nset"/>
        <rdfs:comment xml:lang="en">Links a Point Load or Boundary Condition to the Node Set it acts on. Domain is intentionally open.</rdfs:comment>
        <rdfs:label xml:lang="en">node set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#orientation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#orientation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#BeamSection"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Vector3D"/>
        <rdfs:comment xml:lang="en">Links a Beam Section to the vector defining the local orientation of its cross-section along the beam axis.</rdfs:comment>
        <rdfs:label xml:lang="en">orientation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#referenced_in_sam -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#referenced_in_sam">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#StructuralAnalysisModel"/>
        <rdfs:comment xml:lang="en">Links any resource (e.g. a building, bridge, space, or building element from an external ontology) to the Structural Analysis Model that simulates it. Domain is intentionally open.</rdfs:comment>
        <rdfs:label xml:lang="en">referenced in SAM</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/beo#BuiltElement"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/bot#Element"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/brot/0.21Bridge"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#referenced_object -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#referenced_object">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Instance"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Object"/>
        <rdfs:comment xml:lang="en">Links an Instance to the Object it places within the Assembly.</rdfs:comment>
        <rdfs:label xml:lang="en">references object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#section_material -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#section_material">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Section"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Material"/>
        <rdfs:comment xml:lang="en">Links a Section to the default Material it uses.</rdfs:comment>
        <rdfs:label xml:lang="en">section material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#selfWeight -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#selfWeight">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#LoadCase"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Vector3D"/>
        <rdfs:comment xml:lang="en">Links a Load Case to the vector defining the direction and magnitude of the self-weight it applies.</rdfs:comment>
        <rdfs:label xml:lang="en">self-weight</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#xAxis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#xAxis">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CoordinateSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Vector3D"/>
        <rdfs:comment xml:lang="en">The Coordinate System&apos;s X axis vector.</rdfs:comment>
        <rdfs:label xml:lang="en">X axis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#yAxis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#yAxis">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CoordinateSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Vector3D"/>
        <rdfs:comment xml:lang="en">The Coordinate System&apos;s Y axis vector.</rdfs:comment>
        <rdfs:label xml:lang="en">Y axis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/sso#zAxis -->


    <owl:ObjectProperty rdf:about="https://w3id.org/sso#zAxis">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CoordinateSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/sso#Vector3D"/>
        <rdfs:comment xml:lang="en">The Coordinate System&apos;s Z axis vector.</rdfs:comment>
        <rdfs:label xml:lang="en">Z axis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/sso#A -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#A">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#GeneralProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The cross-sectional area of a General Profile, given directly rather than derived from shape.</rdfs:comment>
        <rdfs:label xml:lang="en">cross-sectional area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#E -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#ElasticBehaviour"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The material&apos;s Young&apos;s modulus (modulus of elasticity), relating stress to strain in the elastic range.</rdfs:comment>
        <rdfs:label xml:lang="en">Young&apos;s modulus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#I11 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#I11">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#GeneralProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The moment of inertia about the section&apos;s first principal axis, for a General Profile.</rdfs:comment>
        <rdfs:label xml:lang="en">moment of inertia I11</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#I12 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#I12">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#GeneralProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The product of inertia of a General Profile&apos;s cross-section.</rdfs:comment>
        <rdfs:label xml:lang="en">product of inertia I12</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#I22 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#I22">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#GeneralProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The moment of inertia about the section&apos;s second principal axis, for a General Profile.</rdfs:comment>
        <rdfs:label xml:lang="en">moment of inertia I22</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#J -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#J">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#GeneralProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The torsional constant of a General Profile&apos;s cross-section.</rdfs:comment>
        <rdfs:label xml:lang="en">torsional constant</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#X -->


