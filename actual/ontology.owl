        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The wall thickness of a pipe or hexagonal hollow profile.</rdfs:comment>
        <rdfs:label xml:lang="en">wall thickness</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#t1 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#t1">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A wall or flange thickness of a cross-section profile (box, I, or L) — its exact location depends on the profile shape.</rdfs:comment>
        <rdfs:label xml:lang="en">wall/flange thickness t1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#t2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#t2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A second wall or flange thickness of a cross-section profile (box, I, or L) — its exact location depends on the profile shape.</rdfs:comment>
        <rdfs:label xml:lang="en">wall/flange thickness t2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#t3 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#t3">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A third wall thickness (box profile) or web thickness (I profile), depending on the profile shape.</rdfs:comment>
        <rdfs:label xml:lang="en">wall/web thickness t3</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#t4 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#t4">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#BoxProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The fourth wall thickness of a box profile.</rdfs:comment>
        <rdfs:label xml:lang="en">wall thickness t4</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#temperature -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#temperature">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
