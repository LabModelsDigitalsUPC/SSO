        <rdfs:label xml:lang="en">start position x1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#x2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#x2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#DistributedLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The position along the element where a Distributed Load&apos;s end value applies.</rdfs:comment>
        <rdfs:label xml:lang="en">end position x2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#xdir -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#xdir">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#SurfaceLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
