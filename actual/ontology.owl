        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A broad classification of the material (e.g. concrete, steel, timber).</rdfs:comment>
        <rdfs:label xml:lang="en">material category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#material_type -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#material_type">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#Material"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The material&apos;s constitutive type (e.g. &apos;ISOTROPIC&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">material type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#node_count -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#node_count">
