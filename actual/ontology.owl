    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#v2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#v2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#DistributedLoad"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The Distributed Load&apos;s value at its end point.</rdfs:comment>
        <rdfs:label xml:lang="en">end value v2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#x1 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#x1">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
