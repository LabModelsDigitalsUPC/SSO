        <rdfs:label xml:lang="en">as OSAM JSON</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#as_abaqus-inp -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#as_abaqus-inp">
