        <rdfs:domain rdf:resource="https://w3id.org/sso#BoundaryCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The prescribed translation value along Y, when the boundary condition imposes a displacement rather than a simple restraint.</rdfs:comment>
