    <!-- https://w3id.org/sso#material_category -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#material_category">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
