        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The Z component of a Node&apos;s position or a 3D Vector.</rdfs:comment>
        <rdfs:label xml:lang="en">Z coordinate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#a -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/sso#CrossSectionProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A cross-section&apos;s primary planar dimension (e.g. width for a rectangular or box profile, a leg length for an angle, the bottom width for a trapezoid) — its exact geometric role depends on the profile shape.</rdfs:comment>
        <rdfs:label xml:lang="en">dimension a</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#as_OSAM-json -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/sso#as_OSAM-json">
