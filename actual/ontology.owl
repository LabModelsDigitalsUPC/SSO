        <rdfs:domain rdf:resource="https://w3id.org/sso#IProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The width of the second flange of an I-shaped profile.</rdfs:comment>
        <rdfs:label xml:lang="en">flange width b2</rdfs:label>
    </owl:DatatypeProperty>
    


