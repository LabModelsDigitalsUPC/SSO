        <rdfs:domain rdf:resource="https://w3id.org/sso#Element"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of faces of an element, relevant to solid and shell elements.</rdfs:comment>
        <rdfs:label xml:lang="en">face count</rdfs:label>
    </owl:DatatypeProperty>
    


