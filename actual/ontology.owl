        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">A cross-section&apos;s secondary planar dimension (e.g. height for a rectangular or box profile, the other leg length for an angle, the top width for a trapezoid) — its exact geometric role depends on the profile shape.</rdfs:comment>
        <rdfs:label xml:lang="en">dimension b</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/sso#b1 -->


